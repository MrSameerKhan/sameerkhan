<opml version="2.0"><head><title>Layer 1 - Data Ingestion &amp; Validation</title></head><body><outline text="Layer 1 - Data Ingestion &amp; Validation"><outline text="1.1 Data Sources (WHAT data exists)"><outline text="Structured"><outline text="Tables (CSV, Parquet)" /><outline text="Logs / Events" /></outline><outline text="Text"><outline text="Documents" /><outline text="Chats" /><outline text="Emails" /></outline><outline text="Documents &amp; Images"><outline text="PDFs" /><outline text="Images (PNG, JPG, TIFF)" /></outline><outline text="Databases"><outline text="SQL" /><outline text="NoSQL" /></outline><outline text="Cloud Storage"><outline text="AWS S3" /><outline text="DBFS" /></outline><outline text="Streaming Sources"><outline text="Kafka" /></outline></outline><outline text="1.2 Ingestion Mode (HOW data arrives)"><outline text="Batch"><outline text="Historical data" /><outline text="Training / Backfill" /></outline><outline text="Streaming / Real-Time"><outline text="Kafka" /><outline text="Apache Beam" /><outline text="Redis" /></outline></outline><outline text="1.3 Secure Ingestion (CAN we trust access)"><outline text="Encryption / Decryption" /><outline text="IAM / Access Control" /></outline><outline text="1.4 Domain-Specific Extraction"><outline text="OCR-Based"><outline text="Tesseract" /><outline text="AWS Textract" /></outline><outline text="OCR-Free"><outline text="Donut LLM (Image → Text)" /></outline></outline><outline text="1.5 Raw Data Cleaning (REMOVE garbage)"><outline text="Noise removal" /><outline text="Text normalization" /><outline text="Image cleanup" /></outline><outline text="1.6 Schema &amp; Data Quality Validation (CAN ML consume it)"><outline text="Schema normalization" /><outline text="Metadata standardization" /><outline text="Null checks" /><outline text="Range checks" /><outline text="Distribution sanity checks" /></outline><outline text="1.7 Large-Scale Processing"><outline text="PySpark DataFrames" /><outline text="PySpark UDFs" /><outline text="Distributed validation" /></outline><outline text="1.8 Dataset Construction (ML boundary)"><outline text="Label encoding" /><outline text="Class normalization" /><outline text="Multi-label handling" /></outline><outline text="1.9 Train / Validation / Test Split"><outline text="Holdout split" /><outline text="Random split" /><outline text="Time-based split" /><outline text="Group-based split" /></outline><outline text="1.10 Leakage Prevention (INTERVIEW CRITICAL)"><outline text="Target leakage" /><outline text="Time leakage" /><outline text="ID leakage" /></outline><outline text="1.11 Stratification &amp; Balance"><outline text="Preserve class distribution" /></outline><outline text="1.12 Domain Hooks (configured here, applied later)"><outline text="ML"><outline text="Split strategy choice" /></outline><outline text="CV"><outline text="Image basics (pixels, RGB vs gray)" /><outline text="Color spaces" /><outline text="Data augmentation flags" /></outline><outline text="OCR"><outline text="Image quality checks" /><outline text="Text detection vs recognition" /></outline></outline></outline></body></opml>
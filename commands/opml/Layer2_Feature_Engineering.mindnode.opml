<opml version="2.0"><head><title>Layer 2 - Feature Engineering &amp; Preprocessing</title></head><body><outline text="Layer 2 - Feature Engineering &amp; Preprocessing"><outline text="2.1 Objectives"><outline text="Convert raw data into model-ready features" /><outline text="Improve signal-to-noise ratio" /><outline text="Prevent data leakage (fit on train only)" /><outline text="Produce reusable preprocessing artifacts" /></outline><outline text="2.2 Representation Strategy"><outline text="Sparse Representations"><outline text="TF-IDF" /><outline text="N-grams" /><outline text="Statistical features" /></outline><outline text="Dense Representations"><outline text="Word embeddings" /><outline text="Sentence embeddings" /><outline text="Transformer embeddings" /></outline><outline text="Multimodal Representations"><outline text="Image + Text" /><outline text="Text + Metadata" /><outline text="Speech + Vision + Text" /><outline text="Image + Text + Metadata" /></outline></outline><outline text="2.3 Classical ML Feature Engineering"><outline text="Data Cleansing &amp; Imputation"><outline text="Numerical"><outline text="Mean / Median / Mode" /><outline text="KNN imputation" /><outline text="Regression imputation" /></outline><outline text="Categorical"><outline text="Mode" /><outline text="Classifier-based imputation" /></outline><outline text="Advanced"><outline text="Autoencoders for missing data" /><outline text="Multiple imputation" /><outline text="Unsupervised ML imputation" /></outline></outline><outline text="Outlier Handling"><outline text="Statistical"><outline text="Z-score" /><outline text="IQR" /><outline text="Boxplot / Scatter" /></outline><outline text="ML-based"><outline text="Isolation Forest" /><outline text="DBSCAN" /><outline text="One-Class SVM" /></outline></outline><outline text="Scaling &amp; Normalization"><outline text="Log transform" /><outline text="Box-Cox" /><outline text="Yeo-Johnson" /><outline text="Min-Max scaling" /><outline text="Sta